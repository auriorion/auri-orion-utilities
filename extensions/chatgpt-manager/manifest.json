{
  "manifest_version": 3,
  "name": "Auri–Orion ChatGPT Manager",
  "version": "0.6.7",
  "description": "Gestor de ChatGPT con explorador local con inventario ampliado, busqueda asistida, lectura por lotes y eliminacion seleccionada con confirmacion.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Abrir ChatGPT Manager",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "scripting"
  ],
  "optional_host_permissions": [
    "https://chatgpt.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
